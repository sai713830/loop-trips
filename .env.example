# Loop Trips — local / Vercel environment (do not commit real values)
# Copy to .env.local and fill in. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Vercel CLI deploy (project rule: use token only, not global vercel login)
VERCEL_TOKEN=

# Admin desk — required for /admin (production + preview)
ADMIN_PASSWORD=
# Random secret for signing session cookies (e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=
